# WeatherGPT Environment Configuration Template (Non-secret placeholders)

APP_NAME=WeatherGPT-SIH26068
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite:///./weathergpt.db

# Security & CORS Settings
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,*
SECRET_KEY=change-in-production

# Upstream Meteorological & AI Credentials (Optional for local dev)
IMD_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# LLM Integration Settings
WEATHERGPT_LLM_PROVIDER=gemini
WEATHERGPT_LLM_MODEL=gemini-1.5-flash
WEATHERGPT_LLM_TIMEOUT=10.0
WEATHERGPT_LLM_TEMPERATURE=0.2

