# WeatherGPT — Environment Configuration Template
# Copy this file to .env and configure local values (never commit real credentials)

# AI Layer Settings
WEATHERGPT_LLM_PROVIDER=gemini
WEATHERGPT_LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Backend & Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Weather Data Provider (Person 2)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
IMD_API_ENDPOINT=https://mausam.imd.gov.in/api
