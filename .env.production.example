# =============================================================================
# WeatherGPT Production Environment Configuration Template
# =============================================================================
# DO NOT COMMIT REAL SECRETS OR PRODUCTION KEYS TO VERSION CONTROL.
# Copy this file to '.env.production' on your hosting environment.

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
APP_NAME=WeatherGPT-SIH26068
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
# For production PostgreSQL / Managed DB: postgresql://user:password@db-host:5432/weathergpt
# Default fallback: sqlite:///./weathergpt.db
DATABASE_URL=postgresql://weather_user:change_db_password_here@postgres-host:5432/weathergpt_db

# -----------------------------------------------------------------------------
# Security, Auth & CORS Settings
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for web/mobile clients
ALLOWED_ORIGINS=https://weathergpt.moes.gov.in,https://app.weathergpt.org,http://localhost:8000
# Generate a strong 32+ character random secret key for JWT signing
SECRET_KEY=generate-a-secure-random-32-plus-character-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# -----------------------------------------------------------------------------
# Meteorological External Providers
# -----------------------------------------------------------------------------
IMD_API_KEY=your_production_imd_api_key_here
IMD_BASE_URL=https://api.imd.gov.in
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_HTTP_TIMEOUT_SECONDS=5.0
WEATHER_HTTP_MAX_RETRIES=2
WEATHER_CACHE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# LLM Intelligence Providers
# -----------------------------------------------------------------------------
# Primary LLM API Keys
OPENAI_API_KEY=your_production_openai_api_key_here
GEMINI_API_KEY=your_production_gemini_api_key_here

# LLM Integration Tuning Parameters
WEATHERGPT_LLM_PROVIDER=gemini
WEATHERGPT_LLM_MODEL=gemini-1.5-flash
WEATHERGPT_LLM_TIMEOUT=10.0
WEATHERGPT_LLM_TEMPERATURE=0.2
